name: Terraform manual deployment
on:
  workflow_dispatch:
permissions:
  contents: read
  id-token: write
jobs:
  deploy:
    if: vars.TERRAFORM_ENABLED == 'true' && vars.TERRAFORM_DEPLOY_ENABLED == 'true' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    uses: tyler180/github-workflows/.github/workflows/terraform-deploy.yml@{{TERRAFORM_WORKFLOW_REF}}
    with:
      terraform-version: '{{TERRAFORM_VERSION}}'
      working-directory: '{{TERRAFORM_DIRECTORY}}'
      aws-region: ${{ vars.TERRAFORM_AWS_REGION || 'us-west-2' }}
      state-id: ${{ vars.TERRAFORM_STATE_ID }}
      plan-role-arn: ${{ vars.TERRAFORM_PLAN_ROLE_ARN }}
      apply-role-arn: ${{ vars.TERRAFORM_APPLY_ROLE_ARN }}
      environment: ${{ vars.TERRAFORM_ENVIRONMENT }}
